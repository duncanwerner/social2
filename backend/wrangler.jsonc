{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "do-sockets-backend",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHANNEL_HUB", "class_name": "ChannelHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChannelHub"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "do-sockets",
      "database_id": "2cafd4c1-801c-4a7a-b4ff-ea77a0135fc2"
    }
  ]
}
