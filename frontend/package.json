{
  "name": "rotation-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "VITE_BACKEND_URL=https://do-sockets-backend.trebdev.workers.dev npm run build",
    "deploy": "npx wrangler pages deploy dist",
    "preview": "vite preview",
    "preview:pages": "npm run build && npx wrangler pages dev dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions/tsconfig.json",
    "validate:rounds": "node scripts/validate-rounds.ts"
  },
  "dependencies": {
    "@solidjs/router": "2.0.0-next.18",
    "@solidjs/web": "2.0.0-rc.3",
    "solid-js": "2.0.0-rc.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@solidjs/vite-plugin": "^3.0.0-next.33",
    "filesystem-routing": "^0.2.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.0"
  }
}
